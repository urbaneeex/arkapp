# =============================================================================
# Arkapp — plantilla de variables de entorno
# =============================================================================
# Copia este archivo:  cp .env.example .env.local
# Rellena los valores reales (nunca subas .env.local al repositorio).
# En Vercel/hosting: configura las mismas claves en el panel de variables.
# =============================================================================

# --- Supabase (obligatorias para auth y datos) -------------------------------
# Dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role: SOLO servidor/API. No expongas al cliente ni en NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: máx. comprobaciones de correo (login) por IP cada 15 min (defecto 40). Ruta /api/auth/lookup-email
# EMAIL_LOOKUP_RATE_MAX=40

# Opcional: script scripts/create_roles_table.js acepta SUPABASE_URL como alias de URL
# SUPABASE_URL=https://xxxxxxxx.supabase.co

# --- URL pública de la app (enlaces en correos, invitaciones) -----------------
# Local: http://localhost:3000  |  Producción: https://partners.arkapp.es
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Supabase → Site URL + Redirect: https://partners.arkapp.es/auth/confirm , /auth/callback
# Entregabilidad DNS: docs/email-deliverability.md

# --- Resend (invitaciones, firmas, vacaciones, reset pass, confirmación) -----
RESEND_API_KEY=re_xxxxxxxxxxxx
# Debe ser @arkapp.es verificado en Resend (p. ej. hello@ o no-reply@)
RESEND_FROM_EMAIL=Arkapp <hello@arkapp.es>

# --- Fichaje QR (tokens firmados) --------------------------------------------
# Mínimo 16 caracteres; cadena aleatoria larga (openssl rand -hex 32)
CLOCK_IN_SECRET=

# --- Cron de archivado de tareas completadas ---------------------------------
# Vercel Cron lo inyecta automáticamente en Authorization: Bearer.
# Generar con: openssl rand -hex 32
CRON_SECRET=

# Beta (opcional): muestra en Inicio el panel «Quién está fichado» (desactivado para usuarios finales).
# NEXT_PUBLIC_DASHBOARD_LIVE_CLOCK_BETA=1

# --- Integraciones opcionales -------------------------------------------------
# Webhook n8n para citas / WhatsApp (si no usas, déjalo vacío)
# N8N_WEBHOOK_URL=https://...

# Evolution API (WhatsApp); solo si usas el módulo de conexión WhatsApp
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=

# --- Solo en Vercel (no hace falta definirlas en local) ----------------------
# VERCEL_URL=...   # asignada automáticamente por Vercel
