# =============================================================================
# Arkapp — plantilla de variables de entorno
# =============================================================================
# Copia este archivo:  cp .env.example .env.local
# Rellena los valores reales (nunca subas .env.local al repositorio).
# En Vercel/hosting: configura las mismas claves en el panel de variables.
# =============================================================================

# --- Supabase (obligatorias para auth y datos) -------------------------------
# Dashboard: Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Service role: SOLO servidor/API. No expongas al cliente ni en NEXT_PUBLIC_*
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Opcional: máx. comprobaciones de correo (login) por IP cada 15 min (defecto 40). Ruta /api/auth/lookup-email
# EMAIL_LOOKUP_RATE_MAX=40

# Opcional: script scripts/create_roles_table.js acepta SUPABASE_URL como alias de URL
# SUPABASE_URL=https://xxxxxxxx.supabase.co

# --- URL pública de la app (enlaces en correos, invitaciones) -----------------
# Local: http://localhost:3000  |  Producción: https://tu-dominio.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Enlaces de correo (reset pass, confirmación de cuenta): deben coincidir con esta URL pública.
# Supabase → Authentication → Redirect URLs: {SITE_URL}/auth/confirm (OAuth Google, magic link); /auth/callback (solo hash tras /auth/confirm).
# Registro por email: confirmación vía Resend → {SITE_URL}/auth/verify-email (ver lib/emails/README.md).

# Opcional: enlaces en notificaciones (webhook citas); por defecto '#'
# NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Resend (invitaciones, firmas, vacaciones, reset pass, confirmación de registro) -----
# Sin RESEND_API_KEY: fallan registro por email (POST /api/auth/register) y reset Arkapp; las APIs de reset responden genérico por privacidad.
RESEND_API_KEY=re_xxxxxxxxxxxx
# Dominio verificado en Resend; debe coincidir con el remitente permitido
RESEND_FROM_EMAIL=Arkapp <no-reply@tudominio.com>

# --- Fichaje QR (tokens firmados) --------------------------------------------
# Mínimo 16 caracteres; cadena aleatoria larga (openssl rand -hex 32)
CLOCK_IN_SECRET=

# --- Integraciones opcionales -------------------------------------------------
# Webhook n8n para citas / WhatsApp (si no usas, déjalo vacío)
# N8N_WEBHOOK_URL=https://...

# Sentry (monitorización de errores frontend/backend)
# Crea proyecto Next.js en sentry.io y copia DSN (Public DSN).
# NEXT_PUBLIC_* se expone al navegador (correcto para DSN público).
# NEXT_PUBLIC_SENTRY_DSN=https://xxxx@o000000.ingest.sentry.io/0000000
# Opcional para sourcemaps automáticos en build (recomendado en Vercel):
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# Evolution API (WhatsApp); solo si usas el módulo de conexión WhatsApp
# EVOLUTION_API_URL=
# EVOLUTION_API_KEY=

# --- Solo en Vercel (no hace falta definirlas en local) ----------------------
# VERCEL_URL=...   # asignada automáticamente por Vercel
